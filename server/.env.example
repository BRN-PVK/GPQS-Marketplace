# Copie este arquivo para .env antes de rodar o projeto.
# Banco SQLite local (arquivo). Para PostgreSQL, troque provider no schema.prisma.
DATABASE_URL="file:./dev.db"

# Porta da API
PORT=3333

# Segredo para assinar tokens JWT (troque por um valor aleatório)
JWT_SECRET="troque-este-segredo-em-producao"

# Tempo de expiração do token
JWT_EXPIRES_IN="7d"

# Origem permitida para o front (CORS)
CORS_ORIGIN="http://localhost:5173"

# Taxa de comissão do marketplace (fração). 0.10 = 10% (usado a partir de C08)
COMMISSION_RATE="0.10"
